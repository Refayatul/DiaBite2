rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for food items to all authenticated users
    match /foodItems/{item} {
      allow read, write: if request.auth != null;
    }
    
    // Users can only access their own data (including favoriteFoodIds and searchHistory root arrays)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow reads/writes to any subcollections under users/{userId} for future use
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /userHistory/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /userFavorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
